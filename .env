# 用于控制ai输出信息的枚举：OFF/DATA/SUGGESTION/BOTH
INFO_MODE=BOTH

# Agent & 工具所需环境变量（缺失项已追加占位）
# OPENAI_API_KEY：OpenAI 模型与向量检索所需
# OPENAI_MODEL：OpenAI 模型名，默认 gpt-4o-mini
# INFO_MODE：OFF | DATA | SUGGESTION | BOTH（默认 BOTH）
# TAVILY_API_KEY：Tavily 检索所需
# RAG_TIER：1|2|3|4，自动映射 data/<n档> 和 CSV_BASE_DIR
# HTML_RAG_DIR：手动指定 HTML 知识库目录（留空使用 RAG_TIER 自动映射）
# CSV_BASE_DIR：CSV 根目录（留空在设置 RAG_TIER 时自动为 ./data）
